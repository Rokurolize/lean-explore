# Potion Problem Integration Configuration
# Copy this file to .env and update the paths for your environment

# Path to the potion_problem workspace
POTION_PROBLEM_PATH=./external/potion_problem

# Path to the API database (optional, defaults to workspace/api_database/mathlib_apis.db)
# POTION_PROBLEM_DB_PATH=C:/Users/id374/workspace/potion_problem/api_database/mathlib_apis.db

# Path to configuration file (optional, defaults to potion_problem_config.yml)
# POTION_PROBLEM_CONFIG_PATH=potion_problem_config.yml